#!/bin/bash

. "${BASH_SOURCE%/*}"/"../dict"
. "${BASH_SOURCE%/*}"/"print_header"

wget_install() {
	local key=$1
	local url=$2
	local version=$3

	local installed_version
	installed_version=$(dpkg-query -W -f='${Version}' "$key" 2> /dev/null)

	if [[ -n "$installed_version" ]]; then
		if [[ -z "$version" || "$installed_version" == "$version"* ]]; then
			echo "$key is already installed, skipping"
			return
		fi
		echo "$key is installed ($installed_version) but $version is available, updating"
	fi

	local temp_dir
	temp_dir=$(mktemp -d)

	print_header "${dict[$key]}"

	wget -q --show-progress -O "${temp_dir}/$key.deb" "$url"
	sudo apt install -y "${temp_dir}/$key.deb"

	rm -rf "$temp_dir"
}
